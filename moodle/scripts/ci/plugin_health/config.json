{
  "_doc": "Konfiguration für check.py. Jede Bewertung (vulnerability_triage) braucht eine nachvollziehbare note und sollte per PR reviewt werden.",
  "fail_level": "FAIL",
  "unreviewed_vulnerability_severity": "FAIL",
  "thresholds": {
    "stale_warn_days": 365,
    "stale_fail_days": 730,
    "no_release_warn_days": 365,
    "pluginsjson_max_age_days": 30,
    "future_version_tolerance_days": 31
  },
  "prerelease_tag_regex": "(?i)(rc\\d*$|-rc|beta|alpha|dev|test)",
  "allowed_duplicates": {
    "auth_oidc": "Upstream aus dem Verzeichnis und eLeDia-Fork werden beide ausgeliefert; pluginCheck.sh wählt zur Laufzeit (eledia_oidc)."
  },
  "maintenance_exceptions_doc": "Komponente -> Begründung. Stufe 'veraltet' wird dann zu INFO. Nur mit nachvollziehbarer Begründung eintragen.",
  "maintenance_exceptions": {},
  "cve_min_term_length": 5,
  "cve_generic_terms": [
    "stack",
    "board",
    "stash",
    "tiles",
    "booking",
    "checklist",
    "heartbeat",
    "cohort",
    "certificate",
    "zoom",
    "union",
    "table",
    "reminder",
    "suspension",
    "dynamic"
  ],
  "cve_aliases": {
    "block_xp": [
      "Level Up XP"
    ],
    "mod_pdfannotator": [
      "PDF Annotator"
    ],
    "auth_oidc": [
      "o365-moodle",
      "moodle-auth_oidc"
    ],
    "mod_hvp": [
      "h5p-moodle-plugin"
    ],
    "local_course_reminder": [
      "course_reminder"
    ]
  },
  "vulnerability_triage": {
    "CVE-2025-60506": {
      "component": "mod_pdfannotator",
      "status": "affected",
      "note": "Stored XSS über öffentliche Kommentare (PoC öffentlich). Kein Fix in v1.5.9 und im Code danach nicht erkennbar (geprüft 2026-10-07)."
    },
    "CVE-2026-54733": {
      "component": "auth_oidc",
      "status": "not_affected",
      "note": "Betrifft local_o365 (Teams-SSO-Endpunkt), nicht auth_oidc. local_o365 wird nicht ausgeliefert (geprüft 2026-10-07) – neu bewerten, falls es hinzukommt."
    }
  },
  "code_patterns": [
    {
      "component": "auth_oidc",
      "file": "classes/loginflow/authcode.php",
      "mode": "required",
      "pattern": "auth_oidc_csrf",
      "reason": "CSRF-Schutz im Login-Callback (upstream 2026-08-10, ab 4.5.8)"
    },
    {
      "component": "auth_oidc",
      "file": "classes/loginflow/authcode.php",
      "mode": "forbidden",
      "pattern": "strpos\\(\\$SESSION->wantsurl,\\s*\\$CFG->wwwroot\\)",
      "reason": "Open Redirect über wantsurl-Präfixprüfung (upstream 2026-07-31 durch is_valid_local_url ersetzt, ab 4.5.8)"
    },
    {
      "component": "auth_oidc",
      "file": "cleanupoidctokens.php",
      "mode": "required",
      "pattern": "require_sesskey\\(\\)",
      "reason": "CSRF beim Löschen von Tokens (upstream 2026-07-20, ab 4.5.8)"
    },
    {
      "component": "auth_oidc",
      "file": "cleanupoidctokens.php",
      "mode": "required",
      "pattern": "s\\(\\$item->oidcusername\\)",
      "reason": "XSS in der Token-Übersicht (upstream 2026-07-20, ab 4.5.8)"
    },
    {
      "component": "mod_pdfannotator",
      "file": "shared/index.js",
      "mode": "required",
      "pattern": "isEvalSupported\\s*:\\s*false",
      "reason": "pdf.js < 4.2.67 mit isEvalSupported=true führt JavaScript aus präparierten PDFs aus (CVE-2024-4367-Klasse). Eintrag entfernen, sobald pdf.js >= 4.2.67 gebündelt ist."
    }
  ],
  "library_map": [
    {
      "match": "^pdf(\\.js|js)$|pdf\\.worker|pdf_viewer|pdfjs",
      "ecosystem": "npm",
      "package": "pdfjs-dist"
    },
    {
      "match": "jspdf",
      "ecosystem": "npm",
      "package": "jspdf"
    },
    {
      "match": "sortable",
      "ecosystem": "npm",
      "package": "sortablejs"
    },
    {
      "match": "bootstrap",
      "ecosystem": "npm",
      "package": "bootstrap"
    },
    {
      "match": "grap(e)?sjs",
      "ecosystem": "npm",
      "package": "grapesjs"
    },
    {
      "match": "font ?awesome",
      "ecosystem": "npm",
      "package": "@fortawesome/fontawesome-free"
    },
    {
      "match": "minicolors",
      "ecosystem": "npm",
      "package": "@claviska/jquery-minicolors"
    },
    {
      "match": "^jquery ui$|jquery-ui",
      "ecosystem": "npm",
      "package": "jquery-ui"
    },
    {
      "match": "^jquery$",
      "ecosystem": "npm",
      "package": "jquery"
    },
    {
      "match": "pdfparser",
      "ecosystem": "Packagist",
      "package": "smalot/pdfparser"
    },
    {
      "match": "chart\\.?js",
      "ecosystem": "npm",
      "package": "chart.js"
    },
    {
      "match": "^vue(\\.js)?$",
      "ecosystem": "npm",
      "package": "vue"
    },
    {
      "match": "moment",
      "ecosystem": "npm",
      "package": "moment"
    },
    {
      "match": "dompurify",
      "ecosystem": "npm",
      "package": "dompurify"
    },
    {
      "match": "mustache",
      "ecosystem": "npm",
      "package": "mustache"
    },
    {
      "match": "tcpdf",
      "ecosystem": "Packagist",
      "package": "tecnickcom/tcpdf"
    },
    {
      "match": "phpspreadsheet",
      "ecosystem": "Packagist",
      "package": "phpoffice/phpspreadsheet"
    },
    {
      "match": "firebase/php-jwt|php-jwt",
      "ecosystem": "Packagist",
      "package": "firebase/php-jwt"
    },
    {
      "match": "guzzle",
      "ecosystem": "Packagist",
      "package": "guzzlehttp/guzzle"
    }
  ]
}
